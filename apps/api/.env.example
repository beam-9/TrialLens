# Recommended hosted option: Workers Free account required. No local GPU inference.
TRIALLENS_CHAT_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Set true only after verifying this account stays on Workers Free, without paid AI credits.
TRIALLENS_CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# Explicit alternative: change provider to ollama to run the model on your own machine.
TRIALLENS_LOCAL_MODEL=qwen3.5:9b

# Optional paid mode: explicitly change provider to openai.
# The US$0.10 app-wide budget applies only to that mode.
OPENAI_API_KEY=
TRIALLENS_CHAT_MODEL=gpt-4.1-mini

# Only needed for a browser that talks directly to the API (normally /api proxies it).
# TRIALLENS_CORS_ORIGINS=https://your-private-site.example

# Optional text-free Ask profiling, disabled unless explicitly enabled.
# TRIALLENS_PERF_TELEMETRY=1
# TRIALLENS_PERF_MODEL_DIGEST=<verified-local-model-digest>
